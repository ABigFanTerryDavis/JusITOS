// ==========================================================================
//  JusITOS 0.0.1 — device tree overlay for QEMU 'virt' on AArch64
// ==========================================================================
//  QEMU's virt machine exposes a simple framebuffer at 0x40000000 by
//  default when -device virtio-gpu-pci is not attached. We use virtio-gpu,
//  so this DT fragment is mostly informational — it documents the
//  framebuffer node the FreeBSD simplefb driver looks for.
//
//  Usage: pass to QEMU with:
//      -machine virt,dtb=jusit-virt.dtb
//  Build this .dts into a .dtb:
//      dtc -I dts -O dtb -o jusit-virt.dtb jusit-virt.dts
// ==========================================================================

/dts-v1/;
/ {
    model = "JusITOS v0.0.1 console reference board";
    compatible = "jusitos,virt-0.0.1", "qemu,virt";
    interrupt-parent = <0x1>;

    aliases {
        serial0 = &uart0;
        framebuffer0 = &fb;
    };

    /* Existing QEMU virt base nodes are inherited when you DON'T pass
       a -dtb flag. If you do pass a dtb, you must include ALL the base
       nodes — copy them from qemu's hw/arm/virt.c defaults. */

    fb: framebuffer@40000000 {
        compatible = "simple-framebuffer";
        reg = <0x0 0x40000000 0x0 0x00800000>;
        width = <640>;
        height = <480>;
        stride = <1920>;
        format = "x8r8g8b8";
    };

    uart0: serial@9000000 {
        compatible = "arm,pl011", "arm,primecell";
        reg = <0x0 0x09000000 0x0 0x1000>;
        interrupts = <0x1 0x1 0xf04>;
        clock-frequency = <0x16e3600>;
    };
};
