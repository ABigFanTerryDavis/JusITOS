# ==========================================================================
# JusITOS 0.0.1 — Custom AArch64 Kernel Configuration
# ==========================================================================
# Based on FreeBSD 14.2-RELEASE GENERIC arm64 config.
# Stripped to a console-shaped profile: fast boot, framebuffer output,
# keyboard input, no multi-user server luggage.
#
# Build with:
#   cd freebsd-src
#   make -j$(nproc) buildkernel TARGET=arm64 KERNCONF=JusITOS-ARM64
#   make -j$(nproc) installkernel TARGET=arm64 KERNCONF=JusITOS-ARM64 \
#       DESTDIR=/path/to/rootfs
# ==========================================================================

include         "std.arm64"
ident           JusITOS-ARM64

# ---- Machine architecture ----
makeoptions     DEBUG=-g
makeoptions     WITH_CTF=1

# ---- CPU options ----
options         SMP                         # Symmetric multi-processor
options         PLATFORM                    # platform bus support
options         FDT                         # Flattened Device Tree
options         OFW                         # Open Firmware support

# ---- Console / boot ----
options         SC_PIXEL_MODE              # syscons: support pixel (framebuffer) modes
options         SC_TWOBLOCK_SCROLL          # smoother scroll
options         VIDEOMODE_DEFAULT=24        # 24bpp framebuffer where available

# ---- Memory model ----
options         IOMMU                      # IOMMU support (for virtio on QEMU)
options         PMAP_HAS_KMI               # kernel mappings invokable
options         VM_NUMA                    # NUMA awareness (cheap on single-die)

# ---- Filesystems (only what a console needs) ----
options         FFS                        # UFS root filesystem
options         FFS_ROOT                   # boot from UFS root
options         MSDOSFS                    # FAT (for EFI System Partition / SD)
options         CD9660                     # ISO9660 (game distribution media)
options         TMPFS                      # in-memory scratch fs
options         UFS_ACL                    # ACLs on UFS
options         UFS_DIRHASH                # faster directory lookups
options         SOFTUPDATES                # soft updates on UFS
options         SUIDDIR

# ---- Networking: keep minimal stack, no routing/firewall ----
options         INET                       # IPv4 (for game downloads later)
options         INET6                      # IPv6
device          loop
device          ether
device          bpf                        # BPF (libpcap-style debugging if needed)
# deliberately NOT including: IPFIREWALL, IPSEC, ROUTETABLES, etc.

# ---- Pseudo-devices ----
device          null
device          zero
device          random                     # /dev/random, /dev/urandom
device          md                         # memory disk
device          fdt                        # Flattened Device Tree pseudo-dev

# ---- VT console (framebuffer text mode) ----
device          vt                         # new vt(4) console (preferred)
device          kbdmux                     # keyboard multiplexer

# ---- Input devices ----
device          ukbd                       # USB keyboard
device          ums                        # USB mouse (future: cursor)
device          atkbdc                     # atkbd controller (for emulated kbd on QEMU)
device          atkbd                      # AT keyboard
device          psm                        # PS/2 mouse

# ---- USB (real gamepad support later) ----
device          xhci                       # USB 3.0 host controller
device          ehci                       # USB 2.0
device          ohci                       # USB 1.1
device          usb                        # USB bus
device          uhub                       # USB hub

# ---- Storage ----
device          ahci                       # SATA
device          ata                        # legacy ATA
device          scbus                      # SCSI bus
device          da                         # Direct Access (disk) devices
device          cd                         # CD-ROM
device          pass                       # SCSI pass-through

# ---- PCI / virtio (essential for QEMU) ----
device          pci                        # PCI bus
device          pci_host_generic           # generic PCI host controller
device          virtio                     # VirtIO core
device          virtio_pci                 # VirtIO over PCI
device          virtio_blk                 # VirtIO block device
device          virtio_net                 # VirtIO net
device          virtio_random              # VirtIO RNG
device          virtio_console             # VirtIO console
device          vtpci                      # virtio-pci glue

# ---- ARM-specific: generic platform / interrupt controller / timer ----
device          gic                        # GIC v2/v3 interrupt controller
device          gtimer                     # ARM Generic Timer
device          pmu                        # Performance Monitoring Unit
device          pl011                      # PL011 UART (QEMU virt default serial)
device          pl031                      # RTC

# ---- Framebuffer: simplefb on QEMU virt ----
device          simplefb                   # simple framebuffer driver
device          fb                         # /dev/fb* generic framebuffer

# ---- Crypto (cheap, useful later for signed games) ----
options         GEOM_BDE                   # block-device encryption
device          crypto                     # /dev/crypto
device          cryptodev                  # /dev/crypto userland interface

# ---- NOT included (intentionally) ----
#   options    IPFIREWALL                  # no firewall in v0.0.1
#   options    IPSEC                       # no IPSec
#   device     wlan                        # no Wi-Fi in v0.0.1
#   device     snd_*                       # no audio in v0.0.1 (M4)
#   device     drm-kmod                    # no GPU accel until M5
#   options    JAIL                        # jails not needed yet
#   options    MAC                         # no mandatory access control
#   options    AUDIT                        # no audit
#   options    NFSD / NFSCLIENT             # no NFS
#   options    ZFS                         # no ZFS
